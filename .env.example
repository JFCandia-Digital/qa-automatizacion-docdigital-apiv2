# URL base de la APIv2 (ambiente demo/test)
API_BASEURL=https://api-demodoc.digital.gob.cl/api

# Opción A) Bearer ya emitido (p. ej. copiado desde Swagger -> Authorize).
# Se usa para el token "válido" cuando no se hace login OAuth en el escenario.
# Nota: los tokens de esta API son de corta duración (~1 h).
ACCESS_TOKEN=

# Opción B) Credenciales OAuth (client_credentials) para obtener el token
# automáticamente vía POST /oauth/token con el step:
#   "que solicito un token de acceso con el cliente ... y el secret ..."
CLIENT_ID_PDI=
CLIENT_SECRET_PDI=
