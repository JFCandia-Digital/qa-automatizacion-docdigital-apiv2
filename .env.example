# URL base de la APIv2
# QA (requiere VPN): https://middleware.docv3.test.digital.gob.cl/api
# demodoc (público):  https://api-demodoc.digital.gob.cl/api
API_BASEURL=https://middleware.docv3.test.digital.gob.cl/api

# Opción A) Bearer ya emitido (p. ej. de POST /oauth/token o Swagger -> Authorize).
ACCESS_TOKEN=

# Opción B) Credenciales OAuth (client_credentials).
# En QA el token se obtiene en POST {host}/api/v3/oauth/token (mismo client_id).
CLIENT_ID_PDI=
CLIENT_SECRET_PDI=

# ID de un documento existente en la entidad, para los GET de E01 con {id}.
DOC_ID_PRUEBA=

# Solo para @Mutacion (excluidos por defecto):
# ID de un documento RECIBIDO desde otra entidad de PRUEBA (para devolver/acusorecibo).
DOC_RECIBIDO_ID=
# ID de la entidad DESTINATARIA (Swagger: listado_id_entidades_destinatarias).
DESTINATARIO_ENTIDAD_ID=
# ID de la entidad ORIGEN (Swagger: id_entidad_creadora). PDI en QA = 66.
# Si se omite, se lee acr.entidadId del ACCESS_TOKEN.
ID_ENTIDAD_CREADORA=
# tipo_id de documento (catálogo GET /tipos/documentos/). Por defecto 1.
TIPO_DOCUMENTO_ID=1
