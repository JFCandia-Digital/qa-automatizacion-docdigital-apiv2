# URL base de la APIv2 (SIN /v3). QA requiere VPN.
# QA:     https://middleware.docv3.test.digital.gob.cl/api
# demodoc: https://api-demodoc.digital.gob.cl/api
API_BASEURL=https://middleware.docv3.test.digital.gob.cl/api

# Opcional. Si está vacío, QA usa POST {host}/api/v3/oauth/token y demodoc /api/oauth/token.
OAUTH_TOKEN_URL=

# Dejá ACCESS_TOKEN vacío: la suite pide el JWT sola con CLIENT_ID/SECRET (dura ~1 h, se renueva sola).
ACCESS_TOKEN=

# Origen (PDI). Obligatorio para lecturas y POST /firmado/ingresar.
CLIENT_ID_PDI=
CLIENT_SECRET_PDI=

# Receptor (Armada). Obligatorio para PUT acusorecibo / devolver.
CLIENT_ID_ARMADA=
CLIENT_SECRET_ARMADA=

# GET /documentos/{id} (p. ej. el último ingresado: 90104 en QA).
DOC_ID_PRUEBA=

# PUT acusorecibo/devolver sobre un recibido PENDIENTE (no uses un id ya acusido).
DOC_RECIBIDO_ID=

# Destino del POST /firmado/ingresar (Armada en QA = 210).
DESTINATARIO_ENTIDAD_ID=210

# Origen del POST. Si se omite, se lee acr.entidadId del JWT (PDI = 66).
ID_ENTIDAD_CREADORA=

# Catálogo GET /tipos/documentos/. 1 = Cartas.
TIPO_DOCUMENTO_ID=1
